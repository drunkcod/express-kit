{
  "name": "@drunkcod/express-kit",
  "type": "module",
  "version": "1.0.0",
  "description": "Express4 utility things",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/**/*",
    "!lib/**/*.spec.*"
  ],
  "exports": {
    ".": {
      "import": {
        "default": "./lib/index.js",
        "types": "./lib/index.d.ts"
      },
      "require": {
        "default": "./lib/cjs/index.js",
        "types": "./lib/cjs/index.d.ts"
      }
    }
  },
  "scripts": {
    "clean": "rimraf lib",
    "compile": "tsc",
    "pre-publish": "node ./scripts/pre-publish.ts ",
    "cjs:compile": "tsc --module commonjs --outdir lib/cjs",
    "cjs:fixup": "echo '{\"type\": \"commonjs\"}' > lib/cjs/package.json",
    "test": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js",
    "test:all": "npm-run-all \"test --workspaces --include-workspace-root -- --verbose=false\" --silent",
    "test:express4": "docker run -it --rm $(docker build -q -t express-kit:express4 --build-arg EXPRESS_VERSION=4 .)",
    "test:express5": "docker run -it --rm $(docker build -q -t express-kit:express5 --build-arg EXPRESS_VERSION=5 .)",
    "docker:cleanup": "docker image rm express-kit:express4 && docker image rm express-kit:express5 && docker builder prune -f --filter type=exec.cachemount",
    "build": "npm-run-all clean -p compile cjs:compile -s cjs:fixup --silent",
    "build:all": "npm-run-all \"build --workspaces --include-workspace-root\" --silent",
    "build:release": "npm-run-all -s pre-publish -p test:express4 test:express5 -s docker:cleanup build:all",
    "modules:refresh": "rimraf node_modules package-lock.json && npm i --save"
  },
  "keywords": [
    "express"
  ],
  "author": "Tobbe Gyllebring <tobbe@drunkcod.com>",
  "license": "MIT",
  "engines": {
    "node": ">=22.10.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "@drunkcod/argis": "^0.0.22",
    "@drunkcod/express-async": "1.0.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@swc/jest": "^0.2.39",
    "@types/node": "^24.13.1",
    "jest": "^30.4.2",
    "npm-run-all2": "^8.0.4",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3"
  }
}
