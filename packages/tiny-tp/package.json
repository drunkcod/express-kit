{
  "name": "@drunkcod/tiny-tp",
  "type": "module",
  "version": "0.0.2",
  "description": "Tiny Traceparent.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/**/*",
    "!lib/**/*.spec.*"
  ],
  "exports": {
    ".": {
      "import": {
        "default": "./lib/index.js",
        "types": "./lib/index.d.ts"
      },
      "require": {
        "default": "./lib/cjs/index.js",
        "types": "./lib/cjs/index.d.ts"
      }
    }
  },
  "scripts": {
    "clean": "rimraf lib",
    "compile": "tsc",
    "cjs:compile": "tsc --module commonjs --outdir lib/cjs",
    "cjs:fixup": "echo '{\"type\": \"commonjs\"}' > lib/cjs/package.json",
    "build": "npm-run-all clean -p compile cjs:compile -s cjs:fixup --silent",
    "test": "node --experimental-vm-modules --disable-warning=ExperimentalWarning ../../node_modules/jest/bin/jest.js"
  },
  "keywords": [
    "express",
    "traceparent"
  ],
  "author": "Tobbe Gyllebring",
  "license": "MIT",
  "engines": {
    "node": ">=22.10.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.1",
    "jest": "^30.4.2",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3"
  }
}
